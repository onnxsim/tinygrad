@A.ir_module
class PipeUnroll:
    @A.prim_func
    def main(x0: A.Buffer((128, 8), "int8x64", scope=A.DDR), x1: A.Buffer((128, 8), "int8x64", scope=A.DDR), x2: A.Buffer((128, 8), "int8x64", scope=A.DDR), x3: A.Buffer((128, 8), "int8x64", scope=A.DDR), x4: A.Buffer((128, 8), "int8x64", scope=A.DDR), x5: A.Buffer((128, 8), "int8x64", scope=A.DDR), x6: A.Buffer((128, 8), "int8x64", scope=A.DDR), x7: A.Buffer((128, 8), "int8x64", scope=A.DDR), x8: A.Buffer((128, 8), "int8x64", scope=A.DDR), x9: A.Buffer((128, 8), "int8x64", scope=A.DDR), x10: A.Buffer((128, 8), "int8x64", scope=A.DDR), x11: A.Buffer((128, 8), "int8x64", scope=A.DDR), x12: A.Buffer((128, 8), "int8x64", scope=A.DDR), x13: A.Buffer((128, 8), "int8x64", scope=A.DDR), x14: A.Buffer((128, 8), "int8x64", scope=A.DDR), x15: A.Buffer((128, 8), "int8x64", scope=A.DDR), w: A.Buffer((512, 8), "int8x64", scope=A.DDR)):
        w_l1 = A.alloc_buffer((512, 8), "int8x64", scope=A.L1)
        axol.atomic.copy(w, output=w_l1)
        w_imc = axol.atomic.load_imc(w_l1)
        s0 = A.alloc_buffer((128, 8), "int8x64", scope=A.L1)
        s1 = A.alloc_buffer((128, 8), "int8x64", scope=A.L1)
        o_full = A.alloc_buffer((2048, 8), "int8x64", scope=A.DDR)
        axol.atomic.copy(x0, output=s0, id='c0')
        A.waits('c0')
        axol.atomic.copy(x1, output=s1, id='c1')
        acc0 = axol.atomic.matmul(matrix_ifd=s0, matrix_imc=w_imc, id='mm0')
        A.waits('mm0', 'c1')
        sc0 = axol.atomic.mul(acc0, 0.000244140625)
        axol.atomic.dpu_cast(sc0, o_full[0 : 128, 0 : 8])
        axol.atomic.copy(x2, output=s0, id='c2')
        acc1 = axol.atomic.matmul(matrix_ifd=s1, matrix_imc=w_imc, id='mm1')
        A.waits('mm1', 'c2')
        sc1 = axol.atomic.mul(acc1, 0.000244140625)
        axol.atomic.dpu_cast(sc1, o_full[128 : 256, 0 : 8])
        axol.atomic.copy(x3, output=s1, id='c3')
        acc2 = axol.atomic.matmul(matrix_ifd=s0, matrix_imc=w_imc, id='mm2')
        A.waits('mm2', 'c3')
        sc2 = axol.atomic.mul(acc2, 0.000244140625)
        axol.atomic.dpu_cast(sc2, o_full[256 : 384, 0 : 8])
        axol.atomic.copy(x4, output=s0, id='c4')
        acc3 = axol.atomic.matmul(matrix_ifd=s1, matrix_imc=w_imc, id='mm3')
        A.waits('mm3', 'c4')
        sc3 = axol.atomic.mul(acc3, 0.000244140625)
        axol.atomic.dpu_cast(sc3, o_full[384 : 512, 0 : 8])
        axol.atomic.copy(x5, output=s1, id='c5')
        acc4 = axol.atomic.matmul(matrix_ifd=s0, matrix_imc=w_imc, id='mm4')
        A.waits('mm4', 'c5')
        sc4 = axol.atomic.mul(acc4, 0.000244140625)
        axol.atomic.dpu_cast(sc4, o_full[512 : 640, 0 : 8])
        axol.atomic.copy(x6, output=s0, id='c6')
        acc5 = axol.atomic.matmul(matrix_ifd=s1, matrix_imc=w_imc, id='mm5')
        A.waits('mm5', 'c6')
        sc5 = axol.atomic.mul(acc5, 0.000244140625)
        axol.atomic.dpu_cast(sc5, o_full[640 : 768, 0 : 8])
        axol.atomic.copy(x7, output=s1, id='c7')
        acc6 = axol.atomic.matmul(matrix_ifd=s0, matrix_imc=w_imc, id='mm6')
        A.waits('mm6', 'c7')
        sc6 = axol.atomic.mul(acc6, 0.000244140625)
        axol.atomic.dpu_cast(sc6, o_full[768 : 896, 0 : 8])
        axol.atomic.copy(x8, output=s0, id='c8')
        acc7 = axol.atomic.matmul(matrix_ifd=s1, matrix_imc=w_imc, id='mm7')
        A.waits('mm7', 'c8')
        sc7 = axol.atomic.mul(acc7, 0.000244140625)
        axol.atomic.dpu_cast(sc7, o_full[896 : 1024, 0 : 8])
        axol.atomic.copy(x9, output=s1, id='c9')
        acc8 = axol.atomic.matmul(matrix_ifd=s0, matrix_imc=w_imc, id='mm8')
        A.waits('mm8', 'c9')
        sc8 = axol.atomic.mul(acc8, 0.000244140625)
        axol.atomic.dpu_cast(sc8, o_full[1024 : 1152, 0 : 8])
        axol.atomic.copy(x10, output=s0, id='c10')
        acc9 = axol.atomic.matmul(matrix_ifd=s1, matrix_imc=w_imc, id='mm9')
        A.waits('mm9', 'c10')
        sc9 = axol.atomic.mul(acc9, 0.000244140625)
        axol.atomic.dpu_cast(sc9, o_full[1152 : 1280, 0 : 8])
        axol.atomic.copy(x11, output=s1, id='c11')
        acc10 = axol.atomic.matmul(matrix_ifd=s0, matrix_imc=w_imc, id='mm10')
        A.waits('mm10', 'c11')
        sc10 = axol.atomic.mul(acc10, 0.000244140625)
        axol.atomic.dpu_cast(sc10, o_full[1280 : 1408, 0 : 8])
        axol.atomic.copy(x12, output=s0, id='c12')
        acc11 = axol.atomic.matmul(matrix_ifd=s1, matrix_imc=w_imc, id='mm11')
        A.waits('mm11', 'c12')
        sc11 = axol.atomic.mul(acc11, 0.000244140625)
        axol.atomic.dpu_cast(sc11, o_full[1408 : 1536, 0 : 8])
        axol.atomic.copy(x13, output=s1, id='c13')
        acc12 = axol.atomic.matmul(matrix_ifd=s0, matrix_imc=w_imc, id='mm12')
        A.waits('mm12', 'c13')
