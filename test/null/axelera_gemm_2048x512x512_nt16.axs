        acc15 = axol.atomic.matmul(matrix_ifd=s1, matrix_imc=w_imc, id='mm15')
        A.waits('mm15')
        sc15 = axol.atomic.mul(acc15, 0.000244140625)
        axol.atomic.dpu_cast(sc15, o_full[1920 : 2048, 0 : 8])
        A.output(o_full)
